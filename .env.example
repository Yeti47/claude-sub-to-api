# Required: the static API key your agent harnesses will use as their Anthropic key.
PROXY_API_KEY=change-me-to-a-long-random-string

# Required so the container can read the bind-mounted Claude config directory
# and write refreshed OAuth tokens back into it.
# Run `id -u` and `id -g` to get your values.
HOST_UID=1000
HOST_GID=1000

# Optional overrides (defaults shown).
# LISTEN_ADDR=:8080
# CREDENTIALS_PATH=/data/.credentials.json
# CLAUDE_CONFIG_DIR=/data
#
# Serverless alternative: pass the full credentials JSON instead of a file.
# When set, it is written to a temporary Claude config directory at boot.
# Refreshed tokens live only in that temporary directory.
# CLAUDE_CREDENTIALS_JSON='{"claudeAiOauth":{"accessToken":"sk-ant-oat...","refreshToken":"sk-ant-ort...","expiresAt":1893456000000}}'
#
# A long-lived token from `claude setup-token` may be supplied instead of a
# credentials file:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#
# LOG_LEVEL=info
# MAX_CONCURRENCY=4
# REQUEST_TIMEOUT_MS=900000
# DEFAULT_MAX_TOKENS=8192
# CLAUDE_CWD=/app
# CLAUDE_CODE_EXECUTABLE=/path/to/claude

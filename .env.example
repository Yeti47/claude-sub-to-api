# Required: the static API key your agent harnesses will use as their Anthropic key.
PROXY_API_KEY=change-me-to-a-long-random-string

# Required: long-lived token from `claude setup-token` (run it once on a machine
# with browser access, complete the login, and paste the token here).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Required so the container can write the Claude config directory, which holds
# .claude.json (onboarding flag) and session transcripts. Run `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# Optional overrides (defaults shown).
# LISTEN_ADDR=:8080
# CLAUDE_CONFIG_DIR=/data
# CLAUDE_CWD=/data/workspace
# STATE_PATH=/data/sub-to-api-sessions.json
# LOG_LEVEL=info
# MAX_CONCURRENCY=4
# REQUEST_TIMEOUT_MS=900000
# DEFAULT_MAX_TOKENS=8192
# CLAUDE_CODE_EXECUTABLE=/path/to/claude

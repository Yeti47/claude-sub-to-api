# Required: the static API key your agent harnesses will use as their Anthropic key.
PROXY_API_KEY=change-me-to-a-long-random-string

# Required so the container can read the bind-mounted credentials file.
# Run `id -u` and `id -g` to get your values.
HOST_UID=1000
HOST_GID=1000

# Optional overrides (defaults shown).
# LISTEN_ADDR=:8080
# UPSTREAM_BASE_URL=https://api.anthropic.com
# CREDENTIALS_PATH=/data/.credentials.json
#
# Serverless alternative: pass the full credentials JSON instead of a file.
# When set, this takes precedence over CREDENTIALS_PATH and no /data volume is
# needed. Refreshed tokens stay in memory only (not written back to the env var).
# CLAUDE_CREDENTIALS_JSON='{"claudeAiOauth":{"accessToken":"sk-ant-oat...","refreshToken":"sk-ant-ort...","expiresAt":1893456000000}}'
#
# LOG_LEVEL=info
# CLAUDE_UA=claude-cli/2.1.44
#
# Keepalive (off by default). AUTO_KEEPALIVE=true starts a background goroutine
# that forces a real OAuth token rotation immediately, then self-schedules each
# next rotation from the token's own expiry (minus REFRESH_LEEWAY), independent
# of any fixed interval, so the token/refresh chain never goes stale while idle.
# You can also toggle auto-keepalive at runtime via the API:
#   POST /v1/keepalive/auto   (enable)
#   DELETE /v1/keepalive/auto (disable)
#   GET /v1/keepalive         (one-shot forced rotation; reports next_refresh_at)
#
# Note: each rotation issues a new refresh token and invalidates the old one.
# If another process (e.g. Claude Code CLI) shares the credentials file, each
# rotation can invalidate its refresh token.
# AUTO_KEEPALIVE=false

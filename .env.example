# Required: the static API key your agent harnesses will use as their Anthropic key.
PROXY_API_KEY=change-me-to-a-long-random-string

# Required so the container can read the bind-mounted credentials file.
# Run `id -u` and `id -g` to get your values.
HOST_UID=1000
HOST_GID=1000

# Optional overrides (defaults shown).
# LISTEN_ADDR=:8080
# UPSTREAM_BASE_URL=https://api.anthropic.com
# CREDENTIALS_PATH=/data/.credentials.json
# LOG_LEVEL=info
# CLAUDE_UA=claude-cli/2.1.44
